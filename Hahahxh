    table.insert(charWatchers, character.ChildAdded:Connect(function(child)
        if not captureMode or not child:IsA("Tool") then return end
        local refused = false
        if captureMode == "gravity" then
            if nameInOtherSlot(child.Name, "single") or slotMismatch(child.Name, "single") then refused = true
            else chosenGravity = child.Name; state.gravityGear = chosenGravity end
        elseif captureMode == "dualGravity" then
            if nameInOtherSlot(child.Name, "dual") or slotMismatch(child.Name, "dual") then refused = true
            else chosenDualGravity = child.Name; state.dualGravityGear = chosenDualGravity end
        elseif captureMode == "speed" then
            if nameInOtherSlot(child.Name, "speed") or slotMismatch(child.Name, "speed") then refused = true
