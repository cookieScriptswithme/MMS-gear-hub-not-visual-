local SPEED_MULTIPLIER = 2.0
local DUAL_PRESETS = {
    [1] = { negation = 0.85, kick = 65, label = "① Current"     },
    [2] = { negation = 1.35, kick = 78, label = "② Upward Bias" },
}
local SLOTS = {
    single = {
        stateKey = "gravActive", gearKey = "gravityGear",
        negation = 0.85, kick = 45,
        rig = { attachment = nil, force = nil, wasOnGround = true },
    },
    dual = {
        stateKey = "dualGravActive", gearKey = "dualGravityGear",
        negation = DUAL_PRESETS[state.dualPreset or 1].negation,
        kick     = DUAL_PRESETS[state.dualPreset or 1].kick,
        rig = { attachment = nil, force = nil, wasOnGround = true },
    },
}
local function applyDualPreset(idx)
    idx = DUAL_PRESETS[idx] and idx or 1
    state.dualPreset = idx
    SLOTS.dual.negation = DUAL_PRESETS[idx].negation
    SLOTS.dual.kick     = DUAL_PRESETS[idx].kick
    saveState()
end

local chosenGravity     = state.gravityGear
local chosenDualGravity = state.dualGravityGear
local chosenSpeed       = state.speedGear

if chosenDualGravity == chosenGravity then chosenDualGravity = nil; state.dualGravityGear = nil end
if chosenSpeed == chosenGravity or chosenSpeed == chosenDualGravity then chosenSpeed = nil; state.speedGear = nil end
if chosenGravity     and slotMismatch(chosenGravity, "single")     then chosenGravity = nil;     state.gravityGear = nil end
if chosenDualGravity and slotMismatch(chosenDualGravity, "dual")   then chosenDualGravity = nil; state.dualGravityGear = nil end
if chosenSpeed       and slotMismatch(chosenSpeed, "speed")        then chosenSpeed = nil;       state.speedGear = nil end
saveState()

local function nameInOtherSlot(name, exceptSlot)
    if not name then return false end
    if exceptSlot ~= "single" and chosenGravity     == name then return true end
    if exceptSlot ~= "dual"   and chosenDualGravity == name then return true end
    if exceptSlot ~= "speed"  and chosenSpeed       == name then return true end
    return false
end

local captureMode = nil
local refreshUI

local function isEquipped(name)
    if not activeChar or not name then return false end
    for _, t in ipairs(activeChar:GetChildren()) do
        if t:IsA("Tool") and t.Name == name then return true end
    end
    return false
end
local function chosenFor(sn)
    if sn == "single" then return chosenGravity end
    if sn == "dual"   then return chosenDualGravity end
end
local function buildRig(rig, root)
    if rig.force then rig.force:Destroy() end
    if rig.attachment then rig.attachment:Destroy() end
    rig.attachment = Instance.new("Attachment"); rig.attachment.Parent = root
    rig.force = Instance.new("VectorForce")
    rig.force.Attachment0 = rig.attachment
    rig.force.RelativeTo = Enum.ActuatorRelativeTo.World
    rig.force.Force = Vector3.zero; rig.force.Enabled = false
    rig.force.Parent = root
end
local function setupRigs()
    if not activeChar then return end
    local root = activeChar:FindFirstChild("HumanoidRootPart")
    if not root then task.defer(setupRigs); return end
    buildRig(SLOTS.single.rig, root)
    buildRig(SLOTS.dual.rig, root)
    SLOTS.single.rig.wasOnGround = true
    SLOTS.dual.rig.wasOnGround = true
end
local function assemblyMass(root)
    local total = root:GetMass()
    local seen = { [root] = true }
    local function gather(p)
        for _, q in ipairs(p:GetConnectedParts()) do
            if not seen[q] then seen[q] = true; total += q:GetMass(); gather(q) end
        end
    end
    gather(root); return total
end
local function runGravitySlot(sn)
    local slot = SLOTS[sn]; local rig = slot.rig
    if not rig.force or not activeChar or not activeHum or activeHum.Health <= 0 then
        if rig.force then rig.force.Enabled = false end
        rig.wasOnGround = true; return
    end
    local gearName = chosenFor(sn)
    local gearOn = state[slot.stateKey]
        and isEquipped(gearName)
        and not slotMismatch(gearName, sn)
    if gearOn then
        local root = activeChar:FindFirstChild("HumanoidRootPart")
        if root then
            rig.force.Force = Vector3.new(0, assemblyMass(root) * Workspace.Gravity * slot.negation, 0)
            rig.force.Enabled = true
        end
    else
        rig.force.Force = Vector3.zero; rig.force.Enabled = false
    end
    local onGround = activeHum.FloorMaterial ~= Enum.Material.Air
    local root = activeChar:FindFirstChild("HumanoidRootPart")
    if gearOn and rig.wasOnGround and not onGround and root then
        local v = root.AssemblyLinearVelocity
        root.AssemblyLinearVelocity = Vector3.new(v.X, slot.kick, v.Z)
    end
    rig.wasOnGround = onGround
end
RunService.Heartbeat:Connect(function()
    if not state.gearHub then
        if SLOTS.single.rig.force then SLOTS.single.rig.force.Enabled = false end
        if SLOTS.dual.rig.force then SLOTS.dual.rig.force.Enabled = false end
        return
    end
    runGravitySlot("single"); runGravitySlot("dual")
end)
RunService.Heartbeat:Connect(function()
    if not state.gearHub or not activeChar or not activeHum or activeHum.Health <= 0 then return end
    local on = state.speedActive
        and isEquipped(chosenSpeed)
        and not slotMismatch(chosenSpeed, "speed")
    if on then
        local md = activeHum.MoveDirection
        activeHum.WalkSpeed = (md.Magnitude > 0) and (16 * SPEED_MULTIPLIER) or 16
    else
        if activeHum.WalkSpeed ~= 16 then activeHum.WalkSpeed = 16 end
    end
end)

