    end))
    table.insert(charWatchers, character.ChildRemoved:Connect(function(child)
        if not child:IsA("Tool") then return end
        if child.Name == chosenGravity then runGravitySlot("single") end
        if child.Name == chosenDualGravity then runGravitySlot("dual") end
        if child.Name == chosenSpeed and activeHum then activeHum.WalkSpeed = 16 end
    end))
end

