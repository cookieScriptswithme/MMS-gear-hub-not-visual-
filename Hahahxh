-- ============================================================
-- SLOT MATCHING
-- ============================================================
local function slotMismatch(gearName, forSlot)
    if not gearName then return false end
    local n = gearName:lower()
    local hasSpeedId   = n:find("99119158", 1, true) ~= nil
    local hasGravityId = n:find("16688968", 1, true) ~= nil
    local saysSpeed    = n:find("speed",   1, true) ~= nil
    local saysGravity  = n:find("gravity", 1, true) ~= nil
    local saysDual     = n:find("dual",    1, true) ~= nil

    if forSlot == "single" then
        if hasSpeedId or saysSpeed then return true end
        if saysDual then return true end
        return false
    elseif forSlot == "dual" then
        if hasSpeedId or saysSpeed then return true end
        return false
    elseif forSlot == "speed" then
        if hasGravityId or saysGravity then return true end
        if saysDual then return true end
        return false
    end
    return false
end

-- ============================================================
-- ANTI FLING
-- ============================================================
-- Three layers:
--   1. Destroy any force/constraint instance the moment it appears on the character
--   2. Clamp linear + angular velocity every frame
--   3. Snap character back to last safe position if a teleport-like delta appears
-- Also unsticks orientation if the character is tipped (fling tip-and-launch vector)
local antiFlingConn        = nil
local antiFlingHeartbeat   = nil
local antiFlingPlayerConns = {}
local lastSafePos          = nil
local tippedFrames         = 0

local function isDangerousInstance(inst)
    return inst:IsA("BodyMover")
        or inst:IsA("VectorForce")
        or inst:IsA("Torque")
        or inst:IsA("AngularVelocity")
        or inst:IsA("LinearVelocity")
        or inst:IsA("AlignPosition")
        or inst:IsA("AlignOrientation")
end

local function nuke(container)
    for _, d in ipairs(container:GetDescendants()) do
        if isDangerousInstance(d) then
            pcall(function() d:Destroy() end)
        end
    end
end

local function installAntiFling(character)
    if antiFlingConn then pcall(function() antiFlingConn:Disconnect() end) end
    lastSafePos = nil
    tippedFrames = 0

    nuke(character)

    antiFlingConn = character.DescendantAdded:Connect(function(desc)
        if isDangerousInstance(desc) then
            pcall(function() desc:Destroy() end)
        end
    end)

    if not antiFlingHeartbeat then
        antiFlingHeartbeat = RunService.Heartbeat:Connect(function()
            if not state.antiFling then return end
            local char = activeChar
            if not char then return end
            local root = char:FindFirstChild("HumanoidRootPart")
            if not root then return end

            -- Layer 2: velocity clamps
            local v = root.AssemblyLinearVelocity
            if v.Magnitude > 200 then
                root.AssemblyLinearVelocity = v.Unit * 200
            end
            local av = root.AssemblyAngularVelocity
            if av.Magnitude > 15 then
                root.AssemblyAngularVelocity = av.Unit * 15
            end

            -- Layer 3a: position snap-back on sudden teleport
            local pos = root.Position
            if lastSafePos then
                local delta = (pos - lastSafePos).Magnitude
                -- 30 studs in one frame at 60fps = 1800 studs/s. Legit movement + kicks are far below.
                if delta > 30 then
                    root.CFrame = CFrame.new(lastSafePos)
                    root.AssemblyLinearVelocity = Vector3.zero
                    root.AssemblyAngularVelocity = Vector3.zero
                else
                    lastSafePos = pos
                end
            else
                lastSafePos = pos
            end

            -- Layer 3b: orientation rescue if heavily tipped for several frames
            local upY = root.CFrame.UpVector.Y
            if upY < 0.3 then
                tippedFrames = tippedFrames + 1
                if tippedFrames > 5 then
                    local look = root.CFrame.LookVector
                    look = Vector3.new(look.X, 0, look.Z)
                    if look.Magnitude < 0.1 then look = Vector3.new(0, 0, -1) end
                    look = look.Unit
                    root.CFrame = CFrame.lookAt(root.Position, root.Position + look)
                    tippedFrames = 0
                end
            else
                tippedFrames = 0
            end
        end)
    end
end

local function startAntiFling()
    if activeChar then installAntiFling(activeChar) end
    table.insert(antiFlingPlayerConns, player.CharacterAdded:Connect(installAntiFling))
end

local function stopAntiFling()
    if antiFlingConn then pcall(function() antiFlingConn:Disconnect() end); antiFlingConn = nil end
    if antiFlingHeartbeat then pcall(function() antiFlingHeartbeat:Disconnect() end); antiFlingHeartbeat = nil end
    for _, c in ipairs(antiFlingPlayerConns) do pcall(function() c:Disconnect() end) end
    antiFlingPlayerConns = {}
    lastSafePos = nil
    tippedFrames = 0
end

-- ============================================================
-- OLD THROW (executes the pastefy script from your menu)
-- ============================================================
local function startOldThrow()
    -- Primary: run the actual throw-old script from the menu
    local ran = pcall(function()
        loadstring(game:HttpGet("https://pastefy.app/GyghlYOG/raw", true))()
    end)
    -- Fallback: if loadstring or network fails, apply the Retargeting flip
    if not ran then
        pcall(function()
            Workspace.Retargeting = Enum.AnimatorRetargetingMode.Disabled
        end)
    end
end

local function stopOldThrow()
    -- We can't reliably undo arbitrary scripts, but Retargeting is the common lever
    if not state.oldAnim then
        pcall(function()
            Workspace.Retargeting = Enum.AnimatorRetargetingMode.Default
        end)
    end
end

