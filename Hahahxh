local ROLE = {
    murderer = { name = "Murderer", color = Color3.fromRGB(255, 60, 60) },
    sheriff  = { name = "Sheriff",  color = Color3.fromRGB(80, 170, 255) },
    innocent = { name = "Innocent", color = Color3.fromRGB(80, 220, 80) },
    unknown  = { name = "Unknown",  color = Color3.fromRGB(200, 200, 200) },
}
local MURDERER_MARKERS, SHERIFF_MARKERS = { "knife" }, { "gun", "revolver", "luger", "colt" }
local function nameMatches(n, markers)
    local s = n:lower()
    for _, m in ipairs(markers) do if s:find(m, 1, true) then return true end end
    return false
end
local function classifyPlayer(plr)
    if not plr then return "unknown" end
    if plr.Character then
        for _, item in ipairs(plr.Character:GetChildren()) do
            if item:IsA("Tool") then
                if nameMatches(item.Name, MURDERER_MARKERS) then return "murderer" end
                if nameMatches(item.Name, SHERIFF_MARKERS) then return "sheriff" end
            end
        end
    end
    local bp = plr:FindFirstChild("Backpack")
    if bp then
        for _, item in ipairs(bp:GetChildren()) do
            if item:IsA("Tool") then
                if nameMatches(item.Name, MURDERER_MARKERS) then return "murderer" end
                if nameMatches(item.Name, SHERIFF_MARKERS) then return "sheriff" end
            end
        end
    end
    return "innocent"
end
local function roleAllowed(rk)
    if rk == "murderer" then return state.espShowMurderer end
    if rk == "sheriff" then return state.espShowSheriff end
    if rk == "innocent" then return state.espShowInnocent end
    return true
end

